# 结对协议配置 —— 换项目时只需要改这个文件
# 被 .pair/ 下所有脚本 source

# 测试命令。必须:全绿退出 0,有失败退出非 0。可用 PAIR_TEST_CMD 环境变量临时覆盖。
TEST_CMD="${PAIR_TEST_CMD:-}"

# 各角色的写权限边界(git pathspec,空格分隔)
TESTER_PATHS="tests"
DEV_PATHS="src"

# 双方都可写
SHARED_PATHS="docs/reviews .pair/STATE.md"

# 谁都不能直接改(改动需走 CONTRACT 变更流程)
FROZEN_PATHS="docs/PLAN.md docs/CONTRACT.md AGENTS.md .agents .claude .pair"
