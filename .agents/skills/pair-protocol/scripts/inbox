#!/usr/bin/env bash
# 看对方上一回合干了什么。这就是你的收件箱 —— 不需要消息总线,git 就是。
. "$(dirname "$0")/lib.sh"

N="${1:-1}"

echo "=== 最近 $N 次交接 ==============================="
git log -n "$N" --format='%h  %s%n      %b' 2>/dev/null || echo "(还没有提交)"
echo
echo "=== 上一回合的完整改动 ==========================="
git show --stat --format='%h %s' HEAD 2>/dev/null || echo "(无)"
echo
echo "--- diff -----------------------------------------"
git show --format='' HEAD 2>/dev/null || true
echo
echo "=== 评审记录 ====================================="
ls -1 docs/reviews/ 2>/dev/null | grep -v '^\.' || echo "(空)"
