#!/usr/bin/env bash
# 回合结束时跑这个。它会校验边界、校验红绿、提交、翻转回合。
# 用法:
#   .pair/handoff "说明"                 # spec / impl 阶段
#   .pair/handoff approve "理由"          # 评审阶段:通过
#   .pair/handoff changes "问题清单"       # 评审阶段:打回
. "$(dirname "$0")/lib.sh"

ME="$(role)"
PHASE="$(sget phase)"
OWNER="$(owner_of "$PHASE")"
ITEM="$(sget item)"

[ "$ME" = "$OWNER" ] || die "现在是 $OWNER 的 $PHASE 回合,不是你($ME)的。不要提交。"

# --- 解析裁决 ---------------------------------------------------------------
VERDICT=""; MSG=""
case "$PHASE" in
  review-impl|review-test)
    case "${1:-}" in
      approve|changes) VERDICT="$1"; MSG="${2:-}" ;;
      *) die "评审阶段必须给出裁决:.pair/handoff approve \"理由\" 或 .pair/handoff changes \"问题清单\"" ;;
    esac
    [ -n "$MSG" ] || die "裁决必须附理由。禁止空手通过。"
    ;;
  *)
    MSG="${1:-}"
    [ -n "$MSG" ] || die "请附一句话说明:.pair/handoff \"你这回合做了什么\""
    ;;
esac

# --- 写权限边界校验 ---------------------------------------------------------
CHANGED="$(git status --porcelain --untracked-files=all | sed 's/^...//' | sed 's/.* -> //')"
ALLOWED="$(allowed_paths "$ME")"

VIOLATIONS=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ "$f" = ".pair/STATE.md" ] && continue
  case "$f" in .pair/.last-test.log) continue ;; esac

  for fr in $FROZEN_PATHS; do
    case "$f" in "$fr"|"$fr"/*) VIOLATIONS="$VIOLATIONS\n  $f  (冻结文件,改动需走 CONTRACT 变更流程)"; continue 2 ;; esac
  done

  ok=0
  for a in $ALLOWED; do
    case "$f" in "$a"|"$a"/*) ok=1; break ;; esac
  done
  [ "$ok" = 1 ] || VIOLATIONS="$VIOLATIONS\n  $f  (越界:$ME 只能写 $ALLOWED)"
done <<< "$CHANGED"

if [ -n "$VIOLATIONS" ]; then
  printf '\n[结对协议] 拒绝交接 —— 以下改动越界:%b\n\n请撤销这些改动后重试。如果你认为规则有问题,写进 docs/reviews/ 并告诉人类。\n\n' "$VIOLATIONS" >&2
  exit 1
fi

# --- 红绿不变量校验 ---------------------------------------------------------
if run_tests; then TESTS=GREEN; else TESTS=RED; fi
case "$PHASE" in
  spec)
    [ "$TESTS" = RED ] || die "spec 阶段结束时测试必须是 RED,现在是 GREEN。
你要么没写新用例,要么写了个本来就能通过的用例。失败的测试才是有效的规格。"
    ;;
  impl)
    [ "$TESTS" = GREEN ] || die "impl 阶段结束时测试必须是 GREEN,现在是 RED。
看 .pair/.last-test.log。还没弄绿就不要交接。"
    ;;
  review-impl|review-test)
    [ "$TESTS" = GREEN ] || die "评审阶段测试不该是 RED。有人破坏了主干,先修好。"
    ;;
esac

# --- 死锁保护 ---------------------------------------------------------------
CHANGES_N="$(sget changes_count)"; CHANGES_N="${CHANGES_N:-0}"
if [ "$VERDICT" = changes ]; then
  CHANGES_N=$((CHANGES_N + 1))
  if [ "$CHANGES_N" -ge 3 ]; then
    sset changes_count "$CHANGES_N"
    die "同一工作项已经被打回 $CHANGES_N 次。协议要求此时停止自动轮转。
请把分歧写清楚,交给人类裁决。不要继续来回。"
  fi
fi

# --- 提交 -------------------------------------------------------------------
case "$PHASE" in
  spec)        PREFIX="test" ;;
  impl)        PREFIX="feat" ;;
  review-impl) PREFIX="review(impl)" ;;
  review-test) PREFIX="review(test)" ;;
esac
[ -n "$VERDICT" ] && PREFIX="$PREFIX/$VERDICT"

# --- 翻转回合 ---------------------------------------------------------------
NEXT=""; NOTE=""
case "$PHASE:$VERDICT" in
  spec:)               NEXT=impl ;;
  impl:)               NEXT=review-impl ;;
  review-impl:approve) NEXT=review-test ;;
  review-impl:changes) NEXT=impl ;;
  review-test:approve) NEXT=spec; NOTE=item-done ;;
  review-test:changes) NEXT=spec ;;
esac

if [ "$NOTE" = item-done ]; then
  sset round "$(( $(sget round) + 1 ))"
  sset item ""
  sset changes_count 0
else
  sset changes_count "$CHANGES_N"
fi
sset phase "$NEXT"
sset last_actor "$ME"

git add -A
git commit -q -m "$PREFIX: $MSG" -m "role=$ME phase=$PHASE -> $NEXT item=${ITEM:-none}"

echo
echo "[结对协议] 已交接。"
echo "  提交: $(git log -1 --oneline)"
echo "  下一阶段: $NEXT  → 归属: $(owner_of "$NEXT")"
[ "$NOTE" = item-done ] && echo "  工作项「$ITEM」已完成并双向通过。"
echo
echo "现在请告诉人类:轮到 $(owner_of "$NEXT") 了。然后停止工作。"
echo
