#!/usr/bin/env bash
# 每个回合开始时第一件事就跑这个。它会告诉你现在该做什么。
. "$(dirname "$0")/lib.sh"

ME="$(role)"
PHASE="$(sget phase)"
OWNER="$(owner_of "$PHASE")"
ITEM="$(sget item)"

echo "=============================================="
echo " 你的角色 : $ME  ($([ "$ME" = tester ] && echo '写测试,不写实现' || echo '写实现,不写测试'))"
echo " 当前工作项: ${ITEM:-（无，等待认领）}"
echo " 当前阶段 : $PHASE   → 归属: $OWNER"

if run_tests; then TESTS=GREEN; else TESTS=RED; fi
echo " 测试状态 : $TESTS   (详见 .pair/.last-test.log)"
echo " 可写路径 : $(allowed_paths "$ME")"
echo "=============================================="

if [ "$ME" != "$OWNER" ]; then
  cat <<MSG

>>> 现在不是你的回合。<<<

不要修改任何文件。跑 .pair/inbox 看对方上一回合做了什么,
然后向人类报告"等待 $OWNER 完成 $PHASE 阶段",并停止。

MSG
  exit 0
fi

echo
echo ">>> 轮到你了。本阶段任务:"
echo
case "$PHASE" in
  spec)
    cat <<'MSG'
  从 docs/PLAN.md 认领下一个工作项,按 docs/CONTRACT.md 的接口签名
  写出【会失败】的测试。只写一个或一组紧密相关的用例,不要一次砸一堆。

  硬约束:
    - 只能写 tests/ 下的文件
    - 只断言 CONTRACT 里的可观测行为,禁止断言私有方法名/调用次数
    - 交接前测试必须是 RED。绿着交接会被 handoff 拒绝。

  完成后: .pair/handoff "一句话说明这个用例在验证什么"
MSG
    ;;
  impl)
    cat <<'MSG'
  读 tests/ 下新增的失败用例,写出让它变绿的最小实现。

  硬约束:
    - 只能写 src/ 下的文件
    - 禁止修改或删除任何测试。认为测试写错了 -> 写异议到 docs/reviews/,
      用 .pair/handoff changes "理由" 打回,由测试方修
    - 禁止针对测试输入硬编码返回值来蒙混过关
    - 交接前测试必须 GREEN

  完成后: .pair/handoff "一句话说明你怎么实现的"
MSG
    ;;
  review-impl)
    cat <<'MSG'
  审查对方的实现。跑 .pair/inbox 看 diff。

  重点查:
    - 有没有针对测试输入特判/硬编码
    - 有没有偏离 docs/CONTRACT.md
    - 有没有明显未覆盖的边界情况(如果有,记下来,下个 spec 回合补测试)

  必须给出裁决,禁止只说"看起来不错":
    通过    -> .pair/handoff approve "理由"
    打回    -> .pair/handoff changes "具体到行的问题清单"
  打回前先把详细意见写进 docs/reviews/。
MSG
    ;;
  review-test)
    cat <<'MSG'
  审查对方的测试。跑 .pair/inbox 看 diff。

  重点查:
    - 有没有断言私有实现细节,导致测试变成变更探测器
    - 覆盖是否够(边界值、错误路径)
    - 用例是否真的对应 PLAN 里的工作项

  必须给出裁决,禁止只说"看起来不错":
    通过    -> .pair/handoff approve "理由"
    打回    -> .pair/handoff changes "具体问题清单"
  打回前先把详细意见写进 docs/reviews/。
MSG
    ;;
esac
echo
